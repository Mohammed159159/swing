# ==============================================================================
# Furuta Pendulum (.gitattributes)
# Git LFS tracking for binary artifacts & cross-platform line ending rules
# ==============================================================================

# ------------------------------------------------------------------------------
# Auto-detect text files and normalize line endings
# ------------------------------------------------------------------------------
* text=auto

# Text file definitions (force LF line endings for consistency across Linux & Windows)
*.m text eol=lf
*.mlx binary
*.py text eol=lf
*.c text eol=lf
*.cpp text eol=lf
*.h text eol=lf
*.hpp text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.xml text eol=lf
*.urdf text eol=lf
*.mjcf text eol=lf
*.tex text eol=lf
*.csv text

# ------------------------------------------------------------------------------
# Git LFS (Large File Storage) Tracking Rules
# (Mandated by HANDBOOK.md §5 for binary models, CAD, ML weights, and data)
# ------------------------------------------------------------------------------

# Simulink Models & Apps
*.slx filter=lfs diff=lfs merge=lfs -text
*.mlapp filter=lfs diff=lfs merge=lfs -text
*.fig filter=lfs diff=lfs merge=lfs -text

# MATLAB Binary Data
*.mat filter=lfs diff=lfs merge=lfs -text

# CAD Assemblies, Parts & 3D Meshes
*.step filter=lfs diff=lfs merge=lfs -text
*.stp filter=lfs diff=lfs merge=lfs -text
*.stl filter=lfs diff=lfs merge=lfs -text
*.sldprt filter=lfs diff=lfs merge=lfs -text
*.sldasm filter=lfs diff=lfs merge=lfs -text
*.f3d filter=lfs diff=lfs merge=lfs -text
*.obj filter=lfs diff=lfs merge=lfs -text

# Machine Learning Models & Weights (Shadow Track)
*.onnx filter=lfs diff=lfs merge=lfs -text
*.pt filter=lfs diff=lfs merge=lfs -text
*.pth filter=lfs diff=lfs merge=lfs -text
*.zip filter=lfs diff=lfs merge=lfs -text

# PDF Documents & Media Binaries
*.pdf filter=lfs diff=lfs merge=lfs -text
*.png filter=lfs diff=lfs merge=lfs -text
*.jpg filter=lfs diff=lfs merge=lfs -text
*.jpeg filter=lfs diff=lfs merge=lfs -text
*.mp4 filter=lfs diff=lfs merge=lfs -text
